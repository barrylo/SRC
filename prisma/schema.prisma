generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id          String     @id @default(uuid()) @map("order_id")
  userId      String?    @map("user_id")
  totalAmount Decimal    @map("total_amount") @db.Decimal(12,2)
  status      String
  createdAt   DateTime   @default(now()) @map("created_at")
  items       LineItem[]

  @@map("orders")
}

model LineItem {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String   @map("order_id")
  productId  String   @map("product_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(12,2)
  totalPrice Decimal? @map("total_price") @db.Decimal(12,2)

  @@map("line_items")
}

model Profile {
  id              String           @id @default(uuid()) @map("profile_id")
  lastname        String
  firstname       String
  rental          Decimal          @db.Decimal(12,2)
  room            String
  address         String
  status          String
  createdAt       DateTime         @default(now()) @map("created_at")
  rentalLineItems RentalLineItem[]

  @@map("profiles")
}

model RentalLineItem {
  id                    String   @id @default(uuid()) @map("rental_line_item_id")
  profile               Profile  @relation(fields: [profileId], references: [id])
  profileId             String   @map("profile_id")
  month                 String
  rental                Decimal  @db.Decimal(12,2)
  previousMonthElecRead Int      @map("previous_month_elec_read")
  currentMonthElecRead  Int      @map("current_month_elec_read")
  electricityFees       Decimal  @map("electricity_fees") @db.Decimal(12,2)
  waterFees             Decimal  @map("water_fees") @db.Decimal(12,2)
  total                 Decimal  @db.Decimal(12,2)

  @@map("rental_line_items")
}
